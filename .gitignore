# ── 비밀값 ───────────────────────────────────────
# LLM API 키 · DB 접속 정보. .env는 커밋하지 않고 노션으로 별도 공유한다.
.env
.env.*
*.pem
*.key

# ── Python ──────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/

# ── uv / 가상환경 ────────────────────────────────
# uv.lock과 .python-version은 커밋 대상이므로 제외하지 않는다.
.venv/
venv/

# ── 테스트 · 린트 캐시 ────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# ── 런타임 산출물 ────────────────────────────────
*.log
logs/

# ── 로컬 AI 작업 자료 ────────────────────────────
# Codex·Fable에 전달하는 기획서와 프롬프트는 로컬에서만 관리한다.
/CODEXPROMPT/

# ── Excel 임시파일 ───────────────────────────────
# import_mapping 작업 중 Excel이 만드는 잠금파일
~$*.xls*
.~lock.*

# ── 에디터 · OS ──────────────────────────────────
.vscode/
.idea/
.DS_Store

docker-compose.yml